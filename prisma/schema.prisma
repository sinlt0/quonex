datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Guild {
  id            String         @id
  prefix        String?
  ticketCounter Int            @default(0)
  createdAt     DateTime       @default(now())
  premium       Premium?
  noPrefix      GuildNoPrefix?
  panels        Panel[]
  tickets       Ticket[]
  applicationPanels ApplicationPanel[]
  applications      Application[]
  greetSettings     GreetSettings?
  levelSettings     LevelSettings?
  interactiveMessages InteractiveMessage[]
  securitySettings    SecuritySettings?
  reactionRoles       ReactionRole[]
}

model Premium {
  id        String    @id @default(cuid())
  guildId   String    @unique
  guild     Guild     @relation(fields: [guildId], references: [id])
  expiresAt DateTime?
  lifetime  Boolean   @default(false)
  addedBy   String
  addedAt   DateTime  @default(now())
}

model PremiumKey {
  id          String    @id @default(cuid())
  key         String    @unique
  duration    String
  createdBy   String
  createdAt   DateTime  @default(now())
  claimedBy   String?
  claimedAt   DateTime?
  usedGuildId String?
}

model GlobalNoPrefix {
  userId  String   @id
  addedBy String
  addedAt DateTime @default(now())
}

model GuildNoPrefix {
  id        String              @id @default(cuid())
  guildId   String              @unique
  guild     Guild               @relation(fields: [guildId], references: [id])
  mode      String
  updatedBy String
  updatedAt DateTime            @default(now())
  users     GuildNoPrefixUser[]
}

model GuildNoPrefixUser {
  id              String        @id @default(cuid())
  guildNoPrefixId String
  guildNoPrefix   GuildNoPrefix @relation(fields: [guildNoPrefixId], references: [id])
  userId          String
  addedAt         DateTime      @default(now())

  @@unique([guildNoPrefixId, userId])
}

model Panel {
  id                  String   @id @default(cuid())
  guildId             String
  guild               Guild    @relation(fields: [guildId], references: [id])
  name                String
  categoryIds         String[]
  channelId           String
  messageId           String?
  staffRoleIds        String[]
  questions           String[]
  transcriptChannelId String?
  createdBy           String
  createdAt           DateTime @default(now())
  tickets             Ticket[]
}

model Ticket {
  id        String    @id @default(cuid())
  guildId   String
  guild     Guild     @relation(fields: [guildId], references: [id])
  panelId   String
  panel     Panel     @relation(fields: [panelId], references: [id])
  channelId String    @unique
  number    Int
  openerId  String
  status    String    @default("open")
  claimedBy String?
  createdAt DateTime  @default(now())
  closedAt  DateTime?
  closedBy  String?
}

model ApplicationPanel {
  id              String        @id @default(cuid())
  guildId         String
  guild           Guild         @relation(fields: [guildId], references: [id])
  name            String
  channelId       String
  messageId       String?
  reviewChannelId String
  reviewerRoleIds String[]
  acceptRoleId    String?
  questions       String[]
  createdBy       String
  createdAt       DateTime      @default(now())
  applications    Application[]
}

model Application {
  id              String    @id @default(cuid())
  guildId         String
  guild           Guild     @relation(fields: [guildId], references: [id])
  panelId         String
  panel           ApplicationPanel @relation(fields: [panelId], references: [id])
  applicantId     String
  answers         Json
  status          String    @default("pending")
  reviewMessageId String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
}

model GreetSettings {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id])

  joinEnabled        Boolean  @default(false)
  joinChannelId       String?
  joinBlocks          Json     @default("[{\"type\":\"text\",\"content\":\"Welcome {user} to **{server_name}**! You're member #{member_count}.\"}]")
  joinCardEnabled     Boolean  @default(false)
  joinCardBackground  String?
  joinDmEnabled       Boolean  @default(false)
  joinDmBlocks        Json     @default("[{\"type\":\"text\",\"content\":\"Welcome to **{server_name}**, {user_name}!\"}]")

  leaveEnabled   Boolean @default(false)
  leaveChannelId String?
  leaveBlocks    Json    @default("[{\"type\":\"text\",\"content\":\"**{user_tag}** left the server. We now have {member_count} members.\"}]")

  banEnabled   Boolean @default(false)
  banChannelId String?
  banBlocks    Json    @default("[{\"type\":\"text\",\"content\":\"**{user_tag}** was banned from the server.\"}]")
  banDmEnabled Boolean @default(false)
  banDmBlocks  Json    @default("[{\"type\":\"text\",\"content\":\"You have been banned from **{server_name}**.\"}]")

  updatedAt DateTime @updatedAt
}

model BotStatus {
  id            Int      @id @default(1)
  guildCount    Int      @default(0)
  ping          Int      @default(0)
  uptimeSeconds Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model Afk {
  id      String   @id @default(cuid())
  guildId String
  userId  String
  reason  String   @default("AFK")
  since   DateTime @default(now())

  @@unique([guildId, userId])
}

model LevelSettings {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id])

  enabled           Boolean  @default(false)
  xpMin             Int      @default(15)
  xpMax             Int      @default(25)
  cooldownSeconds   Int      @default(60)
  levelUpEnabled    Boolean  @default(true)
  levelUpChannelId  String?
  levelUpMessage    String   @default("{user} just reached level **{level}**!")
  ignoredChannelIds String[] @default([])
  noXpRoleIds       String[] @default([])
  voiceXpEnabled     Boolean  @default(false)
  voiceXpPerMinute   Int      @default(10)
  voiceRequireOthers Boolean  @default(true)
  globalMultiplier   Float    @default(1)
  xpMultipliers      Json     @default("[]")
  rankCardEnabled    Boolean  @default(true)
  rankCardAccent     String   @default("#8b7cf6")
  rankCardBackground String?
  roleRewards       LevelRoleReward[]
  updatedAt         DateTime @updatedAt
}

model LevelRoleReward {
  id         String        @id @default(cuid())
  settingsId String
  settings   LevelSettings @relation(fields: [settingsId], references: [id])
  level      Int
  roleId     String

  @@unique([settingsId, level])
}

model MemberLevel {
  id       String    @id @default(cuid())
  guildId  String
  userId   String
  xp       Int       @default(0)
  level    Int       @default(0)
  messages Int       @default(0)
  voiceMinutes Int   @default(0)
  lastXpAt DateTime?

  @@unique([guildId, userId])
  @@index([guildId, xp])
}

model InteractiveMessage {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id])
  name      String
  blocks    Json     @default("[]")
  accentColor  String?
  logChannelId String?
  channelId String?
  messageId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
}

model ReactionRole {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id])
  channelId String
  messageId String
  emoji     String
  roleId    String
  mode      String   @default("toggle")
  createdAt DateTime @default(now())

  @@unique([messageId, emoji])
  @@index([guildId])
}

model TempRole {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  roleId    String
  expiresAt DateTime

  @@unique([guildId, userId, roleId])
  @@index([expiresAt])
}

model SecuritySettings {
  id        String   @id @default(cuid())
  guildId   String   @unique
  guild     Guild    @relation(fields: [guildId], references: [id])
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt
}

model SecurityOwner {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  addedBy   String
  createdAt DateTime @default(now())

  @@unique([guildId, userId])
}

model SecurityWhitelist {
  id        String   @id @default(cuid())
  guildId   String
  targetId  String
  kind      String
  modules   String[] @default(["all"])
  events    String[] @default([])
  addedBy   String
  createdAt DateTime @default(now())

  @@unique([guildId, targetId, kind])
  @@index([guildId])
}

model SecurityLog {
  id         String   @id @default(cuid())
  guildId    String
  module     String
  action     String
  severity   String   @default("info")
  executorId String?
  targetId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([guildId, createdAt])
}

model QuarantineEntry {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  roleIds   String[]
  reason    String?
  createdBy String
  createdAt DateTime @default(now())

  @@unique([guildId, userId])
}

model SecurityTimer {
  id        String   @id @default(cuid())
  guildId   String
  kind      String
  targetId  String?
  data      Json?
  expiresAt DateTime

  @@index([expiresAt])
  @@index([guildId, kind])
}

model SecurityBackup {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  auto      Boolean  @default(false)
  data      Json
  createdBy String
  createdAt DateTime @default(now())

  @@index([guildId])
}

model SecurityStrike {
  id      String   @id @default(cuid())
  guildId String
  userId  String
  count   Int      @default(0)
  lastAt  DateTime @default(now())

  @@unique([guildId, userId])
}

model SecurityLock {
  id        String   @id @default(cuid())
  guildId   String
  channelId String
  prev      Json
  createdAt DateTime @default(now())

  @@unique([guildId, channelId])
}

model WebVerifySession {
  id        String    @id @default(cuid())
  guildId   String
  userId    String
  token     String    @unique
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([guildId, userId])
  @@index([expiresAt])
}

model VerifiedIdentity {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  ipHash    String
  fpHash    String?
  vpn       Boolean  @default(false)
  vpnKind   String?
  country   String?
  verdict   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, ipHash])
  @@index([guildId, fpHash])
}

model ModCase {
  id          String    @id @default(cuid())
  guildId     String
  caseNumber  Int
  userId      String
  moderatorId String
  action      String
  reason      String?
  duration    Int?
  auto        Boolean   @default(false)
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([guildId, caseNumber])
  @@index([guildId, userId])
  @@index([guildId, createdAt])
}

model ModCounter {
  guildId      String    @id
  last         Int       @default(0)
  lastAppeal   Int       @default(0)
  lastReport   Int       @default(0)
  lastReportAt DateTime?
}

model ModAppeal {
  id         String    @id @default(cuid())
  guildId    String
  number     Int
  userId     String
  caseNumber Int?
  text       String
  status     String    @default("pending")
  reviewerId String?
  reviewNote String?
  channelId  String?
  messageId  String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@unique([guildId, number])
  @@index([guildId, status])
  @@index([guildId, userId])
}

model ModReport {
  id              String    @id @default(cuid())
  guildId         String
  number          Int
  reporterIds     String[]  @default([])
  reasons         String[]  @default([])
  targetId        String
  channelId       String
  messageId       String
  content         String?
  attachments     Int       @default(0)
  status          String    @default("open")
  actions         String[]  @default([])
  handlerId       String?
  reportChannelId String?
  reportMessageId String?
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  @@unique([guildId, number])
  @@unique([guildId, messageId])
  @@index([guildId, status])
}

model ModNote {
  id        Int      @id @default(autoincrement())
  guildId   String
  userId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  @@index([guildId, userId])
}

model ModWatch {
  guildId   String
  userId    String
  reason    String?
  addedBy   String
  createdAt DateTime @default(now())

  @@id([guildId, userId])
}

model TempVoiceSettings {
  guildId            String   @id
  logChannelId       String?
  saveProfiles       Boolean  @default(true)
  autoTransfer       Boolean  @default(true)
  graceSeconds       Int      @default(30)
  maxChannels        Int      @default(50)
  blockDuringRaid    Boolean  @default(true)
  allowInvites       Boolean  @default(false)
  panelEnabled       Boolean  @default(true)
  createdAt          DateTime @default(now())
}

model TempVoiceLobby {
  id             String   @id @default(cuid())
  guildId        String
  channelId      String   @unique
  categoryId     String?
  nameTemplate   String   @default("{username}'s room")
  userLimit      Int      @default(0)
  bitrate        Int?
  cooldownSeconds Int     @default(10)
  allowedRoleIds String[] @default([])
  blockedRoleIds String[] @default([])
  ownerManaged   Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([guildId])
}

model TempVoiceChannel {
  channelId      String   @id
  guildId        String
  lobbyId        String
  ownerId        String
  panelMessageId String?
  createdAt      DateTime @default(now())

  @@index([guildId])
  @@index([guildId, ownerId])
}

model TempVoiceProfile {
  guildId   String
  userId    String
  name      String?
  userLimit Int?
  bitrate   Int?
  locked    Boolean  @default(false)
  hidden    Boolean  @default(false)
  trusted   String[] @default([])
  blocked   String[] @default([])
  updatedAt DateTime @updatedAt

  @@id([guildId, userId])
}
