# ===================================================================
# Quonex - unified .gitignore (bot + dashboard, single monorepo)
# ===================================================================

# ---- Dependencies ----
node_modules/
dashboard/node_modules/
.pnp
.pnp.js

# ---- Environment / secrets ----
.env
.env.*
!.env.example
dashboard/.env
dashboard/.env.*
!dashboard/.env.example

# ---- Next.js (dashboard) build output ----
dashboard/.next/
dashboard/out/
.next/
out/

# ---- Build / cache artifacts ----
build/
dist/
.turbo/
.swc/
*.tsbuildinfo
.cache/

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Prisma ----
# Generated client output (if ever configured to emit locally)
prisma/generated/
*.db
*.db-journal

# ---- Runtime / local data ----
*.pid
*.sock
/tmp/*.sock

# ---- OS / editor ----
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# ---- Coverage / test output ----
coverage/
.nyc_output/

# ---- Misc ----
*.tgz
*.tar.gz
*.zip
.vercel
